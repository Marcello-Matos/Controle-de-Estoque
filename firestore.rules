rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só acessa os próprios dados, guardados em /usuarios/{seu uid}/...
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Convidados só são reconhecidos com e-mail verificado (Google já vem verificado).
    function emailVerificado() {
      return request.auth != null
        && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true;
    }

    function caminhoAcesso(uid) {
      return /databases/$(database)/documents/usuarios/$(uid)/acessos/$(request.auth.token.email.lower());
    }

    function convidado(uid) {
      return emailVerificado() && exists(caminhoAcesso(uid));
    }

    function podeLer(uid) {
      return dono(uid) || convidado(uid);
    }

    function podeEditar(uid) {
      return dono(uid) || (convidado(uid) && get(caminhoAcesso(uid)).data.papel == 'edicao');
    }

    function acessoValido(d, uid, email) {
      return d.keys().hasAll(['email', 'papel', 'donoUid', 'donoNome', 'criadoEm'])
        && d.keys().hasOnly(['email', 'papel', 'donoUid', 'donoNome', 'criadoEm'])
        && d.email == email
        && email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && email != request.auth.token.get('email', '').lower()
        && d.papel in ['leitura', 'edicao']
        && d.donoUid == uid
        && d.donoNome is string && d.donoNome.size() > 0 && d.donoNome.size() <= 100;
    }

    function caminhoPerfil(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function caminhoProduto(uid, id) {
      return /databases/$(database)/documents/usuarios/$(uid)/produtos/$(id);
    }

    function caminhoMovimentacao(uid, id) {
      return /databases/$(database)/documents/usuarios/$(uid)/movimentacoes/$(id);
    }

    function perfilValido(d) {
      return d.keys().hasAll(['nome'])
        && d.keys().hasOnly(['nome', 'email', 'criadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 100
        && (!('email' in d) || d.email == null || d.email is string);
    }

    // A movimentação deste produto é criada nesta mesma operação (batch/transação).
    function movimentacaoNova(uid, id, produtoId) {
      return id is string
        && !exists(caminhoMovimentacao(uid, id))
        && existsAfter(caminhoMovimentacao(uid, id))
        && getAfter(caminhoMovimentacao(uid, id)).data.produtoId == produtoId;
    }

    function produtoValido(d) {
      return d.keys().hasAll(['nome', 'descricao', 'categoria', 'codigoBarras', 'quantidade',
          'estoqueMinimo', 'precoCompra', 'precoVenda', 'imagem', 'criadoEm', 'atualizadoEm', 'ultimaMovimentacaoId'])
        && d.keys().hasOnly(['nome', 'descricao', 'categoria', 'codigoBarras', 'quantidade',
          'estoqueMinimo', 'precoCompra', 'precoVenda', 'imagem', 'criadoEm', 'atualizadoEm', 'ultimaMovimentacaoId'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 150
        && d.descricao is string && d.descricao.size() <= 2000
        && d.categoria is string && d.categoria.size() <= 100
        && (d.codigoBarras == null || (d.codigoBarras is string && d.codigoBarras.size() <= 50))
        && (d.imagem == null || (d.imagem is string && d.imagem.size() <= 900000))
        && d.quantidade is int && d.quantidade >= 0
        && d.estoqueMinimo is int && d.estoqueMinimo >= 0
        && d.precoCompra is number && d.precoCompra >= 0
        && d.precoVenda is number && d.precoVenda >= 0
        && d.atualizadoEm == request.time;
    }

    // O produto precisa ser atualizado na mesma operação, com a quantidade exata.
    function movimentacaoConsistente(uid, movId, m) {
      let caminho = caminhoProduto(uid, m.produtoId);
      let depois = getAfter(caminho).data;
      let antes = exists(caminho) ? get(caminho).data.quantidade : 0;
      return m.produtoId is string
        && existsAfter(caminho)
        && depois.ultimaMovimentacaoId == movId
        && depois.nome == m.produtoNome
        && ((m.tipo == 'entrada' && depois.quantidade == antes + m.quantidade)
          || (m.tipo == 'saida' && depois.quantidade == antes - m.quantidade));
    }

    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid) && perfilValido(request.resource.data)
        && request.resource.data.criadoEm == request.time;
      allow update: if dono(uid) && perfilValido(request.resource.data)
        && (!('criadoEm' in resource.data) || request.resource.data.criadoEm == resource.data.criadoEm);
      allow delete: if false;

      // Pessoas com quem o dono compartilhou o estoque (ID do documento = e-mail em minúsculas).
      match /acessos/{email} {
        allow read: if dono(uid) || (emailVerificado() && email == request.auth.token.email.lower());
        allow create: if dono(uid) && acessoValido(request.resource.data, uid, email)
          && request.resource.data.criadoEm == request.time;
        allow update: if dono(uid) && acessoValido(request.resource.data, uid, email)
          && request.resource.data.criadoEm == resource.data.criadoEm;
        // O dono remove o acesso; o convidado pode sair do estoque compartilhado.
        allow delete: if dono(uid) || (emailVerificado() && email == request.auth.token.email.lower());
      }

      match /produtos/{produtoId} {
        allow read: if podeLer(uid);

        // Estoque inicial > 0 exige uma movimentação de entrada criada junto.
        allow create: if podeEditar(uid)
          && produtoValido(request.resource.data)
          && request.resource.data.criadoEm == request.time
          && ((request.resource.data.quantidade == 0 && request.resource.data.ultimaMovimentacaoId == null)
            || (request.resource.data.quantidade > 0
              && movimentacaoNova(uid, request.resource.data.ultimaMovimentacaoId, produtoId)));

        // A quantidade só muda junto com o registro de uma movimentação.
        allow update: if podeEditar(uid)
          && produtoValido(request.resource.data)
          && request.resource.data.criadoEm == resource.data.criadoEm
          && ((request.resource.data.quantidade == resource.data.quantidade
              && request.resource.data.ultimaMovimentacaoId == resource.data.ultimaMovimentacaoId)
            || movimentacaoNova(uid, request.resource.data.ultimaMovimentacaoId, produtoId));

        // Só o dono exclui, e só produtos sem movimentações (preserva o histórico).
        allow delete: if dono(uid) && resource.data.ultimaMovimentacaoId == null;
      }

      match /movimentacoes/{movId} {
        allow read: if podeLer(uid);

        // O responsável é sempre quem está logado (dono ou convidado com permissão de edição).
        allow create: if podeEditar(uid)
          && request.resource.data.keys().hasAll(['produtoId', 'produtoNome', 'tipo', 'quantidade',
            'responsavel', 'responsavelUid', 'observacoes', 'data'])
          && request.resource.data.keys().hasOnly(['produtoId', 'produtoNome', 'tipo', 'quantidade',
            'responsavel', 'responsavelUid', 'observacoes', 'data'])
          && request.resource.data.tipo in ['entrada', 'saida']
          && request.resource.data.quantidade is int && request.resource.data.quantidade > 0
          && request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 1000
          && request.resource.data.responsavelUid == request.auth.uid
          && request.resource.data.responsavel == get(caminhoPerfil(request.auth.uid)).data.nome
          && request.resource.data.data == request.time
          && movimentacaoConsistente(uid, movId, request.resource.data);

        // Histórico é imutável.
        allow update, delete: if false;
      }
    }

    // Permite ao convidado descobrir quais estoques foram compartilhados com ele.
    match /{caminho=**}/acessos/{email} {
      allow read: if emailVerificado() && resource.data.email == request.auth.token.email.lower();
    }
  }
}
